{
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "emitDeclarationOnly": false,
      "strict": true,
      "esModuleInterop": true,
      "module": "ESNext",
      "target": "ESNext",
      "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules"]
  }