{
    "compilerOptions": {
      "jsx": "react",
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": false,
      "emitDeclarationOnly": false,
      "strict": true,
      "esModuleInterop": true,
      "module": "ESNext",
      "target": "ESNext",
      "skipLibCheck": true,
      "sourceMap": false,
    },
    "include": ["src"],
    "exclude": ["node_modules", "src/__tests__/**/*"]
  }